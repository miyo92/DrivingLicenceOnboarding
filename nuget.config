<?xml version="1.0" encoding="utf-8"?>
<!-- Restore this repository from nuget.org only; machine-wide package sources are ignored. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
